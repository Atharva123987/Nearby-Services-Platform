# Copy to .env and adjust. Never commit .env.
# Load order (later wins): code defaults -> .env -> .env.<APP_ENV> -> process environment.
# Under docker compose, DATABASE_URL and REDIS_URL are overridden to use service hostnames.

# --- App ---------------------------------------------------------------------
# dev | test | prod. prod refuses to start with a default/short JWT_SECRET or CORS_ORIGINS=*.
APP_ENV=dev
APP_NAME=Fieldguide API
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Postgres (docker compose `db` service) ----------------------------------
POSTGRES_USER=fieldguide
POSTGRES_PASSWORD=fieldguide
POSTGRES_DB=fieldguide
# Host port the db container is published on.
POSTGRES_PORT=5432

# --- Database (API) ----------------------------------------------------------
# Async SQLAlchemy URL (asyncpg driver). localhost works when the API runs on the host.
DATABASE_URL=postgresql+asyncpg://fieldguide:fieldguide@localhost:5432/fieldguide
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=5
# Log every SQL statement.
DB_ECHO=false

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=1
# Host port the redis container is published on.
REDIS_PORT=6379

# --- Auth --------------------------------------------------------------------
# Required in prod: at least 32 random chars, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=replace-me-with-a-long-random-string
# Only HS256 is accepted (pinned; `alg: none` tokens are rejected).
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Used by `python -m app.scripts.create_admin` when --email/--password are not passed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Rate limiting (requests per minute per client) --------------------------
RATE_LIMIT_ENABLED=true
# Applies to every /api/v1 route; the tiers below are enforced on top of it.
RATE_LIMIT_DEFAULT_PER_MINUTE=100
# GET /api/v1/services/nearby
RATE_LIMIT_NEARBY_PER_MINUTE=30
# POST/PATCH/DELETE /api/v1/admin/*
RATE_LIMIT_ADMIN_WRITE_PER_MINUTE=60
# POST /api/v1/auth/login, counted per client IP and, separately, per email.
# A successful login clears that email's counters (not the IP's).
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_HOUR=20
# Comma-separated proxy IPs/CIDRs (e.g. 10.0.0.0/8). X-Forwarded-For is only read when the
# direct peer is one of these; leave empty when the API is not behind a proxy.
TRUSTED_PROXIES=

# --- Cache TTLs (seconds) ----------------------------------------------------
CACHE_TTL_DEFAULT_SECONDS=300
CACHE_TTL_SEARCH_SECONDS=60
CACHE_TTL_SERVICE_DETAIL_SECONDS=600
CACHE_TTL_EMPTY_SECONDS=15

# --- HTTP --------------------------------------------------------------------
# Comma-separated list of allowed browser origins. `*` is rejected in prod.
CORS_ORIGINS=http://localhost:3000
# Per-dependency timeout for GET /ready.
READY_CHECK_TIMEOUT_SECONDS=2
# Host port the api container is published on.
API_PORT=8000

# --- Frontend ----------------------------------------------------------------
# Base URL the browser uses to reach the API (baked into the bundle at build time).
# CARTO browser basemap key for the nearby, detail and admin maps.
NEXT_PUBLIC_CARTO_BASEMAP_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
# API URL for server-side calls from Next (admin login/refresh). Defaults to NEXT_PUBLIC_API_URL;
# docker-compose sets it to http://api:8000. Admin tokens are kept in httpOnly cookies, never in JS.
# API_INTERNAL_URL=http://localhost:8000
# Host port the web container is published on.
WEB_PORT=3000
